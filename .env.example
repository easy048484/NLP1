# Anthropic Claude (공식 SDK 사용) — 팀 결정: LLM은 Claude만 사용
ANTHROPIC_API_KEY=
# 대화·합성용 모델 (heir_navigator, orchestrator)
CLAUDE_MODEL=claude-opus-5
# 추출 폴백용 모델 (decedent_estate, asset_organizer — 정규식 실패 시에만 호출)
CLAUDE_EXTRACT_MODEL=claude-haiku-4-5-20251001
# 라우팅 분류 전용 모델 (orchestrator/planner._llm_route — 매 턴 1회, 짧은 분류).
# 비우면 CLAUDE_MODEL 을 그대로 씁니다.
CLAUDE_ROUTER_MODEL=

# 오케스트레이터 LLM 사용 여부. auto | on | off | required
# auto(기본값)면 ANTHROPIC_API_KEY가 있을 때만 LLM 플래너/컴포저를 사용합니다.
# required는 데모·운영용: LLM 실패 시 폴백하지 않고 예외를 올리고, 키가 없으면
# 서버 기동 자체가 실패합니다 (조용한 열화 방지).
ORCHESTRATOR_USE_LLM=auto

# Database (docker-compose 기본값과 일치)
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/family_assets

# FastAPI
APP_ENV=local

# 만료 데이터 정리 주기(초). 비로그인 세션(2시간)과 방치된 익명 가족관계
# 그래프를 실제로 삭제하는 배치가 이 간격으로 돕니다. 0 이하면 배치를 띄우지
# 않습니다 (테스트에서 끄고 싶을 때).
PURGE_INTERVAL_SECONDS=900
CORS_ORIGINS=http://localhost:5173

# 인증 — 액세스 토큰(JWT) 서명 키. 배포 환경에서는 반드시 임의의 긴 값으로
# 설정하세요. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 비어 있으면 개발용 기본 시크릿이 쓰이고 경고 로그가 남습니다.
JWT_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
