# 사용할 LLM. claude | upstage | k-exaone
LLM_PROVIDER=claude

# Anthropic Claude (공식 SDK 사용)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Upstage Solar (OpenAI 호환)
# https://api.upstage.ai/v1/chat/completions
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro4

# LG K-EXAONE (경진대회 제공, Friendli dedicated / OpenAI 호환)
# Endpoint ID가 model 이름입니다. 키와 ID는 .env에만 넣고 커밋하지 마세요.
K_EXAONE_API_KEY=
K_EXAONE_BASE_URL=https://api.friendli.ai/dedicated/v1
K_EXAONE_ENDPOINT_ID=

# 오케스트레이터 LLM 사용 여부. auto | on | off
# auto(기본값)면 ANTHROPIC_API_KEY가 있을 때만 LLM 플래너/컴포저를 사용합니다.
ORCHESTRATOR_USE_LLM=auto

# Database (docker-compose 기본값과 일치)
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/family_assets

# FastAPI
APP_ENV=local
CORS_ORIGINS=http://localhost:5173

# 인증 — 액세스 토큰(JWT) 서명 키. 배포 환경에서는 반드시 임의의 긴 값으로
# 설정하세요. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 비어 있으면 개발용 기본 시크릿이 쓰이고 경고 로그가 남습니다.
JWT_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
