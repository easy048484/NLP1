# 사용할 LLM. upstage | k-exaone
LLM_PROVIDER=upstage

# Upstage Solar (OpenAI 호환)
# https://api.upstage.ai/v1/chat/completions
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro4

# LG K-EXAONE (경진대회 제공, Friendli dedicated / OpenAI 호환)
# Endpoint ID가 model 이름입니다. 키와 ID는 .env에만 넣고 커밋하지 마세요.
K_EXAONE_API_KEY=
K_EXAONE_BASE_URL=https://api.friendli.ai/dedicated/v1
K_EXAONE_ENDPOINT_ID=

# Database (docker-compose 기본값과 일치)
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/family_assets

# FastAPI
APP_ENV=local
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
