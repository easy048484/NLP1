    "RED": { "label": "확인 안 됨", "meaning": "무효 방향 판례 확립", "precedent_status": "확립 판례 존재", "card_count": 1 },
    "YELLOW": { "label": "쟁점 있음", "meaning": "사실관계 따라 갈림", "precedent_status": "판례 분기", "card_count": 2 },
    "WHITE": { "label": "참고", "meaning": "법정 요건 아님", "precedent_status": "해당 없음", "card_count": 0 },
    "PENDING": { "label": "확인 대기", "meaning": "텍스트로 판별 불가", "precedent_status": "없음", "card_count": 0 }
